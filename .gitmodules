[submodule "ThirdParty/ghostty"]
	path = ThirdParty/ghostty
	url = https://github.com/ghostty-org/ghostty.git
	shallow = true
[submodule "ThirdParty/zmx"]
	path = ThirdParty/zmx
	# GraphCode's fork tracks scgopi/zmx main and carries the Windows platform port.
	# The graphcode-windows branch must stay rebased onto upstream main.
	url = https://github.com/simra/zmx.git
	shallow = true
